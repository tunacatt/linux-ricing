/* {
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
   "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "localip",
    "locale",
    "break",
    "colors"
  ]
} */

{
  "display": {
    "separator": "  ",
    "key": { "width": 14 },          // aligns the columns
    "color": { "keys": "blue", "title": "magenta" }
  },
  "modules": [
    {
    	"type": "title",
    	"color": {
    		"user": "yellow",
    		"at": "white",
    		"host": "green"
    	},
    	"format": "󱩛 {user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    "separator",
    { "type": "os",       "key": " OS", "keyColor": "red", "format": "{2} {9} {12}" },
    { "type": "kernel",   "key": " Kernel", "keyColor": "red" },
    { "type": "packages", "key": "󰏖 Packages" },
    { "type": "shell",    "key": " Shell" },
    { "type": "wm",       "key": "󰖲 WM" },
    { "type": "terminal", "key": " Terminal" },
    "separator",
    { "type": "cpu",      "key": " CPU", "keyColor": "red", "format": "{name} ({cores-logical} logical cores) @ {freq-base}" },
    { "type": "gpu",      "key": "󰢮 GPU", "keyColor": "magenta" },
    { "type": "memory",   "key": "󰍛 RAM", "keyColor": "yellow" },
    { "type": "swap",     "key": " Swap", "keyColor": "yellow" },
    { "type": "disk",     "key": "󰋊 Disk", "keyColor": "38;5;244" },
    { "type": "uptime",   "key": "󰅐 Uptime", "keyColor": "38;5;244" },
    "separator",
    { "type": "command",  "key": " GCC", "text": "gcc --version | head -n 1", "keyColor": "green" },
    { "type": "command", "key": " Git", "text": "git --version", "keyColor": "green" },
    { "type": "command", "key": " Node.js", "text": "echo 'node' $(node --version)", "keyColor": "green" },
    "break",
    "colors"
  ]
}
